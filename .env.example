# ==============================================================================
# Amazon Customer Support AI — Environment Configuration Template
# Copy this file to .env and insert your actual API credentials.
# ==============================================================================

# ─── LLM Provider Credentials ────────────────────────────────────────────────
# Set at least one API key. The system will auto-detect and round-robin balance
# across all providers with valid keys configured.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── Provider Orchestration ──────────────────────────────────────────────────
# Preferred primary provider: 'groq', 'gemini', or 'openai' (default: groq)
LLM_PROVIDER=groq

# Primary model name override (optional)
LLM_MODEL_NAME=groq/compound

# Number of consecutive requests to assign to each provider before rotating (default: 5)
ROUND_ROBIN_CHUNK_SIZE=5

# ─── Embedding Model ─────────────────────────────────────────────────────────
# Model used for indexing and vector search in ChromaDB (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
